# ── App ──────────────────────────────────────────────────
APP_NAME=Buildlyst
APP_VERSION=1.0.0
DEBUG=true

# ── Database ─────────────────────────────────────────────
DB_PATH=./buildlyst.db



# ── API Keys ─────────────────────────────────────────────
GEMINI_API_KEY=
WEB3FORMS_ACCESS_KEY=

# ── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# ── Chatbot ──────────────────────────────────────────────
CHAT_MAX_HISTORY=20
CHAT_SESSION_TTL_SECONDS=3600
